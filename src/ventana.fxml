            <StackPane style="-fx-background-color: #E0E0E0; -fx-border-color: black; -fx-border-width: 1;">
                <TextArea fx:id="textAreaComedor" editable="false" prefHeight="60" prefWidth="100" />

                      <Region style="-fx-pref-width: 100; -fx-pref-height: 60;" />
            </StackPane>
            <!-- Celda de comida con altura reducida y fondo gris -->
            <StackPane style="-fx-background-color: #E0E0E0; -fx-border-color: black; -fx-border-width: 1;">
                <Label fx:id="lblComida" text="Comida" />
                <Region style="-fx-pref-width: 60; -fx-pref-height: 40;" />
            </StackPane>
        </HBox>

              <!-- Separador -->
        <Separator style="-fx-background-color: #333333; -fx-border-color: #333333; -fx-border-width: 1;" />

              <!-- Fila 3: Zona Común -->
        <HBox prefHeight="82.0" prefWidth="326.0" spacing="10">
