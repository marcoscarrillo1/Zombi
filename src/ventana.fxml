            </StackPane>
        </HBox>

              <!-- Separador -->
        <Separator style="-fx-background-color: #333333; -fx-border-color: #333333; -fx-border-width: 1;" />

              <!-- Fila 2: Comedor (aumentando tamaño de HBox y reduciendo altura de comida) -->
