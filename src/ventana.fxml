<HBox prefHeight="750.0" prefWidth="928.0" spacing="10" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="VentanaController">

          <!-- Espaciado y padding -->
    <padding>
