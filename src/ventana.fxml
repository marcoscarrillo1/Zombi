            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>
            <StackPane style="-fx-background-color: #E0E0E0; -fx-border-color: black; -fx-border-width: 1;">
                <TextArea fx:id="textAreaTunel4" prefWidth="100" prefHeight="60" editable="false"  />
                <Region style="-fx-pref-width: 100; -fx-pref-height: 60;" />
            </StackPane>
            <StackPane style="-fx-background-color: #E0E0E0; -fx-border-color: black; -fx-border-width: 1;">
                <TextArea fx:id="textAreaTunel5" prefWidth="100" prefHeight="60"  editable="false"  />
                <Region style="-fx-pref-width: 60; -fx-pref-height: 60;" />
            </StackPane>
            <StackPane style="-fx-background-color: #E0E0E0; -fx-border-color: black; -fx-border-width: 1;">
                <TextArea fx:id="textAreaTunel6" prefWidth="100" prefHeight="60" editable="false" />
                <Region style="-fx-pref-width: 100; -fx-pref-height: 60;" />
            </StackPane>
        </HBox>
        <Separator style="-fx-background-color: #333333; -fx-border-color: #333333; -fx-border-width: 1;" />

        <!-- Fila 3 -->
        <HBox spacing="10">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>
            <StackPane style="-fx-background-color: #E0E0E0; -fx-border-color: black; -fx-border-width: 1;">
                <TextArea fx:id="textAreaTunel7" prefWidth="100" prefHeight="60" editable="false" />
                <Region style="-fx-pref-width: 100; -fx-pref-height: 60;" />
            </StackPane>
            <StackPane style="-fx-background-color: #E0E0E0; -fx-border-color: black; -fx-border-width: 1;">
                <TextArea fx:id="textAreaTunel8" prefWidth="100" prefHeight="60" editable="false" />
                <Region style="-fx-pref-width: 60; -fx-pref-height: 60;" />
            </StackPane>
            <StackPane style="-fx-background-color: #E0E0E0; -fx-border-color: black; -fx-border-width: 1;">
                <TextArea fx:id="textAreaTunel9" prefWidth="100" prefHeight="60" editable="false" />
                <Region style="-fx-pref-width: 100; -fx-pref-height: 60;" />
            </StackPane>
        </HBox>
        <Separator style="-fx-background-color: #333333; -fx-border-color: #333333; -fx-border-width: 1;" />

        <!-- Fila 4 -->
        <HBox spacing="10.0">
            <StackPane style="-fx-background-color: #E0E0E0; -fx-border-color: black; -fx-border-width: 1;">
                <TextArea fx:id="textAreaTunel10" prefWidth="100" prefHeight="60" editable="false" />
                <Region style="-fx-pref-width: 100; -fx-pref-height: 60;" />
            </StackPane>
            <StackPane style="-fx-background-color: #E0E0E0; -fx-border-color: black; -fx-border-width: 1;">
                <TextArea fx:id="textAreaTunel11" prefWidth="100" prefHeight="60" editable="false" />
                <Region style="-fx-pref-width: 60; -fx-pref-height: 60;" />
            </StackPane>
            <StackPane style="-fx-background-color: #E0E0E0; -fx-border-color: black; -fx-border-width: 1;">
                <TextArea fx:id="textAreaTunel12" prefWidth="100" prefHeight="60" editable="false" />
                <Region style="-fx-pref-width: 100; -fx-pref-height: 60;" />
            </StackPane>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
        </HBox>
    </VBox>













    <!-- Caja Zona de Riesgo -->
    <VBox style="-fx-background-color: #FFD580; -fx-border-color: black; -fx-border-width: 1;">
        <!-- Título con fondo gris -->
        <Label prefHeight="45.0" prefWidth="235.0" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 10; -fx-background-color: #E0E0E0; -fx-alignment: center;" text="Zona de Riesgo" />

        <!-- Separador: Línea horizontal completa -->
        <Separator style="-fx-background-color: #333333; -fx-border-color: #333333; -fx-border-width: 1;" />

        <!-- Fila 1 -->
        <HBox spacing="10">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>
            <StackPane style="-fx-background-color: #E0E0E0; -fx-border-color: black; -fx-border-width: 1;">
