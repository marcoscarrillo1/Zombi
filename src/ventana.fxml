              <!-- Separador -->
        <Separator style="-fx-background-color: #333333; -fx-border-color: #333333; -fx-border-width: 1;" />

              <!-- Fila 1: Zona de Descanso -->
        <HBox spacing="10">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>
            <!-- Título Zona Descanso con fondo gris -->
            <Label style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 5;" text="Zona Descanso" />
            <!-- Celda de IDs con fondo gris -->
            <StackPane style="-fx-background-color: #E0E0E0; -fx-border-color: black; -fx-border-width: 1;">
                <TextArea fx:id="textAreaDescanso" editable="false" prefHeight="60" prefWidth="100" />

