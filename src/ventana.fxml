            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>
            <!-- Título Comedor con fondo gris -->
            <Label style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 5;" text="Comedor" />
            <Label style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 5;" text="Comida" />
